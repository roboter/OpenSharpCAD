<Project>
  <PropertyGroup>
    <Company>OpenSharpCAD</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NetVersion>net10.0</NetVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1570;1572;1573;1574;1587</NoWarn>
    <!-- Allow building Windows-specific projects (e.g. MatterCadGui, PlatformWin32) on non-Windows for CI/cross-build -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
